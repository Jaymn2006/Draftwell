rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Draftwell novel network — guest sessions via Firebase Auth anonymous
    match /novels/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
    match /chapters/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
    match /user_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /user_bookshelves/{id} {
      allow read, write: if request.auth != null;
    }
    match /chapter_unlocks/{id} {
      allow read, write: if request.auth != null;
    }
    match /chapter_star_unlocks/{id} {
      allow read, write: if request.auth != null;
    }
    match /payment_intents/{id} {
      allow read, write: if request.auth != null;
    }
    match /author_earnings/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
